{
  "expo": {
    "name": "Simple Social",
    "slug": "simple-social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "simplesocial",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#161826",
    "ios": {
      "bundleIdentifier": "com.j9systems.simplesocial",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.j9systems.simplesocial",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0b0c14"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#161826"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Simple Social needs access to your photos so you can share them.",
          "cameraPermission": "Simple Social needs camera access so you can take photos to share."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
